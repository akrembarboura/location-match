# Required: MongoDB database connection string (use a dedicated production database).
MONGODB_URI=

# Required: generate a strong, random secret (at least 32 bytes) for signing sessions.
JWT_SECRET=

# Required: canonical public URL for metadata and absolute links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Required for property image uploads.
CLOUDINARY_URL=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
